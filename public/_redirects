# ---------------------------------------------------------------
# strong-4k.com - Cloudflare Pages routing (Next.js static export)
#
# English is served at the site root (one single index.html);
# every other locale is a real pre-rendered directory (/it/, /de/ ...)
# so URLs, canonicals, hreflang and sitemap all agree.
#
# NOTE: do not deploy a Pages Function (functions/index.ts) from the
# v0 workspace with this project - its locale-detection middleware
# answers 302 for every request and breaks the static routes.
# ---------------------------------------------------------------

# Legacy /en prefix -> English root
/en      /  301
/en/*    /  301
